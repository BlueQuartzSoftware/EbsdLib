{
  "$schema": "https://raw.githubusercontent.com/microsoft/vcpkg/master/scripts/vcpkg.schema.json",
  "name": "simplnx",
  "version": "0.1.0",
  "dependencies": [
    {
      "name": "fmt"
    },
    {
      "name": "eigen3"
    },
    {
      "name": "hdf5",
      "features": [
        "cpp",
        "zlib"
      ],
      "version>=": "2.2.0"
    },
    {
      "name": "tiff"
    },
    {
      "name": "stb"
    },
    {
      "name": "libaec"
    }
  ],
  "features": {
    "parallel": {
      "description": "Parallel support with TBB",
      "dependencies": [
        {
          "name": "tbb"
        }
      ]
    },
    "tests": {
      "description": "Tests",
      "dependencies": [
        {
          "name": "catch2"
        }
      ]
    }
  },
  "overrides": [
    {
      "name": "catch2",
      "version-semver": "2.13.9"
    }
  ]
}
